set inst_list [get_entity_instances $entity_name]

}

apply_sdc_pre_config_clock altera_s10_configuration_clock
 11 0 1 / 4 home 7 eelljay 16 PCIe-to-AXI-FPGA 5 build 2 ip 11 pcie_bridge 15 pcie_bridge_dut 25 intel_rtile_pcie_ast_1201 5 synth 20 intel_rtile_pcie.sdc 11949 # (C) 2001-2025 Altera Corporation. All rights reserved.
