	set_connection_parameter_value axi_bridge_hw_0.tx_st3/dut.p0_tx_st3 qsys_mm.widthAdapterImplementation {GENERIC_CONVERTER}

	# add the exports
	set_interface_property hip_serial EXPORT_OF dut.hip_serial
	set_interface_property refclk0 EXPORT_OF dut.refclk0
	set_interface_property refclk1 EXPORT_OF dut.refclk1
